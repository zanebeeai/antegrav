# ── CAN bus ───────────────────────────────────────────────────────────────
# Preferred bus is the CANivore name; if it does not respond we fall back
# through this list (can0 = Jetson native CAN header / SocketCAN). The probe
# is best-effort: if your CANivore is named differently, set `can_bus` in
# vehicle.yaml — that name is always tried first.
CAN_BUS = "canivore"
CAN_BUS_FALLBACKS = ["canivore", "can0"]
CAN_PROBE_TIMEOUT_S = 0.5

# ── files / topics ────────────────────────────────────────────────────────
CONFIG_PATH = "/home/jetson/ethon/vehicle.yaml"
TOPIC_CMD_VEL = "/cmd_vel"
TOPIC_ESTOP = "/ethon/estop"
TOPIC_STATUS = "/ethon/drive_status"

# ── loop rates / timing ───────────────────────────────────────────────────
TICK_HZ = 50.0                 # control loop
STATUS_HZ = 2.0                # /ethon/drive_status publish rate
FEED_ENABLE_S = 0.1            # enable window fed per fresh tick
SIGNAL_PROBE_TIMEOUT_S = 0.5   # CANcoder / version-signal probe timeout
CONFIG_APPLY_RETRIES = 3       # configurator.apply attempts per device
ACKERMANN_MIN_SPEED_MS = 0.3   # below this commanded speed, steer to centre
EFFIC_MIN_DIST_M = 5.0         # min distance before reporting Wh/km (avoid /~0)
# Steering lock-to-lock homing (opt-in via steer_home_method="lock_to_lock").
# UNTESTED — tune every one of these against the real steering before trusting
# it; a wrong stall threshold either never finds the stop or reads a false one.
STEER_HOME_DUTY = 0.10         # open-loop duty swept toward each mechanical stop
STEER_HOME_STALL_RPS = 0.4     # |rotor velocity| below this counts as stalled
STEER_HOME_STALL_S = 0.35      # ...sustained this long = the stop was reached
STEER_HOME_TIMEOUT_S = 6.0     # abort a sweep if no stop is found in this time
STEER_HOME_MARGIN_ROT = 0.05   # column rotations kept inside each stop (soft limit)
STEER_HOME_RATE_HZ = 100.0     # sweep control-loop rate
TOPIC_DRIVE_TEST = "/ethon/drive_test"   # bench-test direct duty override (Float64)
TEST_TIMEOUT_S = 0.5           # bench-test command watchdog (dashboard re-posts
                               # continuously; motors stop within this if it stops)

# ── configurable vehicle constants (overridden by vehicle.yaml) ───────────
# Keys marked MEASURE are placeholders — measure on the car before driving.
CONFIG_DEFAULTS = {
    # CAN
    "can_bus": CAN_BUS,
    "drive_master_id": 0,
    "drive_follower_ids": [1, 2],
    "steer_can_id": 3,
    "cancoder_can_id": 4,
    # drivetrain
    "wheel_dia_m": 26 * 0.0254,     # 26" rear wheel
    "gear_ratio": 11.46,            # motor rotations per wheel rotation
    "max_speed_ms": 8.0,            # /cmd_vel saturation speed
    "drive_inverted": False,        # BENCH-VERIFY: +cmd must roll forward
    "steer_inverted": False,        # BENCH-VERIFY: +angular.z must steer LEFT
    "max_drive_a": 80.0,            # full torque current (cool motors)
    "min_drive_a": 50.0,            # derated current at temp ceiling
    "derate_lo_c": 55.0,
    "derate_hi_c": 70.0,
    "reverse_cap": 0.30,            # reverse torque fraction
    "regen_a": 40.0,                # max regen braking current
    "regen_deadband_ms": 0.5,       # m/s below wheel speed before regen
    "regen_ramp_ms": 2.0,           # m/s of speed error for full regen
    # control mode: True = TorqueCurrentFOC (needs a Phoenix Pro license per
    # device); False = DutyCycleOut, open-loop, no license required. Live-
    # toggleable from the dashboard. Default False so the drive works on
    # unlicensed devices; flip to True once Pro licensing is sorted.
    "use_foc": False,
    "test_max_duty": 0.30,          # bench-test duty-cycle safety cap (fraction)
    # steering
    "wheelbase_m": 1.60,            # MEASURE
    "steer_col_ratio": 12.0,        # MEASURE — steering-wheel deg per road-wheel deg
    "steer_belt_ratio": 4.0,        # MEASURE — motor rots per column rot
    "steer_limit_rot": 1.0,         # MEASURE — soft limit, +/- column rots
    "steer_max_a": 15.0,            # driver must be able to overpower
    # homing method: "cancoder" (seed rotor from the absolute CANcoder) or
    # "lock_to_lock" (sweep to both mechanical stops, centre on the midpoint,
