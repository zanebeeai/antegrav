[Unit]
Description=Ethon web debug dashboard (http://<ip>/dashboard, port 80)
After=network-online.target
Wants=network-online.target

[Service]
User=jetson
WorkingDirectory=/home/jetson/ethon
# allow the non-root jetson user to bind the privileged port 80 (ambient cap
# survives the bash->python exec). Do NOT restrict CapabilityBoundingSet here:
# a tight bounding set prevents the setuid `sudo` (used by the CLEAR E-STOP ->
# ethon_clear_estop.sh restart) from acquiring the privileges it needs.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=no
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && export ROS_DOMAIN_ID=42 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp ROS_LOCALHOST_ONLY=1 && exec python3 /home/jetson/ethon/web_dashboard.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
