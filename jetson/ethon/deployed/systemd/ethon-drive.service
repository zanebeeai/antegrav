[Unit]
Description=Ethon drive controller (Krakens via Phoenix6 on can0)
After=ethon-can.service network.target
Requires=ethon-can.service

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/ethon
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && export ROS_DOMAIN_ID=42 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp ROS_LOCALHOST_ONLY=1 && exec python3 /home/jetson/ethon/ethon_drive.py'
Restart=on-failure
RestartSec=5
# SIGINT first so rclpy shuts down cleanly (motors neutral) before SIGKILL
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
