[Unit]
Description=Bring up can0 (classic CAN 1M, SN65HVD230 transceiver)
Before=ethon-drive.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/ip link set can0 down
ExecStart=/usr/sbin/ip link set can0 up type can bitrate 1000000 dbitrate 2000000 fd on restart-ms 100
ExecStop=/usr/sbin/ip link set can0 down

[Install]
WantedBy=multi-user.target
